NODE_ENV=development

# Server address
HOST="0.0.0.0"
PORT=5002

# Secret key (for JWT), generate using: node -e "console.log(require('crypto').randomBytes(256).toString('base64'));"
JWT_SECRET="super_secret-key@dev"
JWT_ISSUER="custom-boilerplate.com"

# PostgreSQL DB
POSTGRES_DATABASE_URL="postgresql://postgres:password@localhost:5432/life_mat_dev"

# Cache DB
REDIS_DATABASE_HOST=localhost
REDIS_DATABASE_PORT=6379

# Email (Nodemailer), we can use 3 SMTP servers
EMAIL_SERVER_1=
EMAIL_PORT_1=
EMAIL_USERNAME_1=
EMAIL_PASSWORD_1=
EMAIL_SENDER_1=

EMAIL_SERVER_2=
EMAIL_PORT_2=
EMAIL_USERNAME_2=
EMAIL_PASSWORD_2=
EMAIL_SENDER_2=

EMAIL_SERVER_3=
EMAIL_PORT_3=
EMAIL_USERNAME_3=
EMAIL_PASSWORD_3=
EMAIL_SENDER_3=

# SSLCommerz payment gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
PAYMENT_SUCCESS_URL="http://localhost:5004/payment/success"
PAYMENT_FAIL_URL="http://localhost:5004/payment/fail"
PAYMENT_CANCEL_URL="http://localhost:5004/payment/cancel"
API_BASE_URL="http://localhost:5002"

# SMS provider ("console" logs OTPs instead of sending)
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=
